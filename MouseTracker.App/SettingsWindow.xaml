<Window x:Class="MouseTracker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mouseTracker"
        Width="420"
        Height="620"
        Icon="Assets/mouseTracker.ico"
        MinWidth="360"
        MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer Background="#111827"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Border Padding="18" Background="#111827">
        <StackPanel>
            <TextBlock Text="mouseTracker"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#E5F8FF" />

            <TextBlock Text="Entrenamiento visual de raton"
                       Margin="0,4,0,16"
                       Foreground="#9CA3AF" />

            <Border Padding="12" Background="#1F2937" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="TrackingStateText"
                               FontWeight="SemiBold"
                               Foreground="#67E8F9" />
                    <TextBlock Text="Atajos: Ctrl F9 activa la estela. Ctrl F10 muestra u oculta este menu."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="#D1D5DB" />
                    <Button x:Name="ToggleTrackingButton"
                            Content="Activar estela"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            MinWidth="120"
                            Padding="10,4"
                            Click="ToggleTrackingButton_Click" />
                </StackPanel>
            </Border>

            <TextBlock Text="Duracion de la estela"
                       Margin="0,18,0,6"
                       Foreground="#F9FAFB" />
            <Slider x:Name="DurationSlider"
                    Minimum="100"
                    Maximum="3000"
                    TickFrequency="100"
                    IsSnapToTickEnabled="True"
                    ValueChanged="DurationSlider_ValueChanged" />
            <TextBlock x:Name="DurationValueText"
                       HorizontalAlignment="Right"
                       Foreground="#9CA3AF" />

            <TextBlock Text="Color"
                       Margin="0,14,0,6"
                       Foreground="#F9FAFB" />
            <ComboBox x:Name="ColorComboBox"
                      SelectionChanged="ColorComboBox_SelectionChanged" />

            <TextBlock Text="Atajos configurables"
                       Margin="0,18,0,6"
                       Foreground="#F9FAFB" />
            <Border Padding="12" Background="#1F2937" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Activar estela"
                               Foreground="#D1D5DB" />
                    <Button x:Name="ToggleTrackingHotkeyButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="120"
                            Padding="10,4"
                            Click="ToggleTrackingHotkeyButton_Click"
                            PreviewKeyDown="HotkeyButton_PreviewKeyDown" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,10,10,0"
                               VerticalAlignment="Center"
                               Text="Mostrar/ocultar menu"
                               Foreground="#D1D5DB" />
                    <Button x:Name="ToggleSettingsHotkeyButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,10,0,0"
                            MinWidth="120"
                            Padding="10,4"
                            Click="ToggleSettingsHotkeyButton_Click"
                            PreviewKeyDown="HotkeyButton_PreviewKeyDown" />

                    <TextBlock x:Name="HotkeyHelpText"
                               Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Margin="0,12,0,0"
                               Text="Puedes usar combinaciones o teclas sueltas. Las teclas sueltas pueden interferir al escribir o jugar."
                               TextWrapping="Wrap"
                               Foreground="#9CA3AF" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Ocultar"
                        Width="90"
                        Click="HideButton_Click" />
            </StackPanel>
        </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
